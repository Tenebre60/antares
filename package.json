{
  "name": "antares",
  "version": "2.0.1",
  "description": "Antares — navegador orbital baseado em Chromium",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/build-win.js"
  },
  "keywords": [],
  "author": "Antares",
  "license": "MIT",
  "devDependencies": {
    "@electron/asar": "^4.3.2",
    "@electron/fuses": "^2.1.3",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "resedit": "^3.1.1"
  },
  "productName": "Antares",
  "build": {
    "appId": "com.aurora.browser",
    "productName": "Antares",
    "copyright": "Copyright © 2026 Antares",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "electronDist": "build/electron-dist",
    "afterPack": "build/afterPack.js",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "executableName": "Antares"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Antares",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Antares",
      "artifactName": "Antares-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Antares-Portatil-${version}.exe"
    },
    "publish": null
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.3"
  }
}
